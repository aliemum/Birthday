<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Happy Birthday!</title>

    <style>
        body{
            margin:0;
            padding:0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #ff9a9e, #fad0c4);
            text-align:center;
            color:white;
            overflow:hidden;
        }

        .container{
            margin-top:100px;
        }

        h1{
            font-size:50px;
            animation: glow 2s infinite alternate;
        }

        p{
            font-size:22px;
        }

        button{
            padding:15px 30px;
            font-size:20px;
            border:none;
            border-radius:30px;
            background:white;
            color:#ff4d6d;
            cursor:pointer;
            font-weight:bold;
        }

        button:hover{
            transform:scale(1.1);
        }

        #message{
            display:none;
            margin-top:30px;
            animation: fadeIn 2s;
        }

        .cake{
            font-size:100px;
            margin-top:20px;
        }

        @keyframes glow{
            from{
                text-shadow:0 0 10px white;
            }
            to{
                text-shadow:0 0 30px yellow;
            }
        }

        @keyframes fadeIn{
            from{opacity:0;}
            to{opacity:1;}
        }

        .confetti{
            position:absolute;
            width:10px;
            height:10px;
            background:red;
            animation:fall 5s linear infinite;
        }

        @keyframes fall{
            from{
                transform:translateY(-100px) rotate(0deg);
            }
            to{
                transform:translateY(110vh) rotate(360deg);
            }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>🎉 Happy Birthday! 🎉</h1>

    <p>Someone has a surprise for you ❤️</p>

    <button onclick="showMessage()">Open Surprise 🎁</button>

    <div id="message">
        <div class="cake">🎂</div>

        <h2>Happy Birthday, [Name]!</h2>

        <p>
            Wishing you endless happiness, success,
            and beautiful moments in life. ❤️
        </p>

        <h3>Have an amazing day! 🎉</h3>
    </div>
</div>

<script>
function showMessage(){
    document.getElementById("message").style.display="block";

    for(let i=0;i<50;i++){
        let c=document.createElement("div");
        c.className="confetti";
        c.style.left=Math.random()*100+"vw";
        c.style.backgroundColor=
        `hsl(${Math.random()*360},100%,50%)`;
        c.style.animationDuration=
        (Math.random()*3+2)+"s";

        document.body.appendChild(c);
    }
}
</script>

</body>
</html>
